# Fastfood Kitchen 环境变量示例
# 复制为 .env 后填写真实值；docker compose 部署时使用

# ===== 通用 =====
NODE_VERSION=24.14.1
API_PORT=3000
# Web Admin 前端代理目标（dev 用本机，容器内为 http://api:3000/api）
API_BASE_URL=http://127.0.0.1:3000/api
# 小程序 API 地址（生产必须为已备案的 HTTPS 业务域名）
TARO_APP_API_BASE_URL=http://127.0.0.1:3000/api

# ===== 数据库（生产必须为 postgres）=====
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
# 必填：生产数据库密码
DB_PASSWORD=change-me
DB_NAME=fastfood_kitchen
# 生产必须为 false（schema 由迁移管理）
DB_SYNCHRONIZE=false
DB_LOGGING=false

# 本地开发可切换回 sql.js（无需数据库）
# DB_TYPE=sqljs
# SQLJS_LOCATION=.data/fastfood-kitchen.sqlite

# ===== 种子与认证 =====
# 生产建议 false；true 仅用于初始化首个管理员
SEED_ON_BOOT=false
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin1234
# 必填：生产 JWT 密钥（openssl rand -hex 32）
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
